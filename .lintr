  "R/aux-expansion-monolith.R",
  "R/parser-monolith.R",
  "R/log-parser-monolith.R",
  "R/jacobian-monolith.R",
  "R/steady-monolith.R",
  "R/perturbation-monolith.R",
  "R/stochsimul-monolith.R",
  "R/transform-monolith.R",
  "R/backend-monolith.R",
  "R/kalman-filter-v4-monolith.R",
  "R/smoother-monolith.R",
  "R/estimation-monolith.R",
  "R/sigma-prop-robust-monolith.R",
  "R/mcmc-parallel-monolith.R",
  "R/estimate-monolith.R",
  "R/estimate-runner.R",
  "R/smc-monolith.R",
  "R/nuts-monolith.R",
  "R/diagnostics-monolith.R",
  "R/obc-monolith.R",
  "R/obc-kf-monolith.R",
  "inst/scripts",
  "inst/pipelines",
  "inst/benchmarks",
  "inst/examples"
)
