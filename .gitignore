# Dynare-generated build artefacts (each .mod file produces <name>/ and
# <name>.log alongside it). Goldens we want to commit are extracted from
# these into inst/extdata/golden/<model>/<stage>.json by the regen script.
inst/extdata/models/*/
inst/extdata/models/*.log
*.jls

# Julia precompile caches
*.jls

# Examples folder — user-run replication examples (not part of package)
manual_checks/

# Temp files generated by diag_prior_sensitivity()
*_flat.mod

examples/
examples/reports/
examples/dynare/*/
examples/dynare/*.log
inst/julia/.CondaPkg/
*.so
*.dylib

# Worktree for tryCatch removal
../dynhr-fix-trycatch/

# Replication folder — user-run replication exercises
replication/

# Estimation artifacts written into the test dir when a test calls the
# estimation API with the default output_dir = "." (cwd). See TEST_REVIEW.md
# D3 — the underlying cwd-littering is a separate flagged item.
tests/testthat/*_mode.rds
tests/testthat/*_mcmc.rds

# Scratch / development workspace (debug scripts, cached RDS, comparison logs)
tmp/
.git_commit_msg.txt
inst/octave/*.log

# Diagnostic-suite render output (large generated artifacts: PNGs + suite.rds)
diagnostic_review_output/
diagnostic_review_output_run.log

# Ephemeral Claude scoping / orchestration docs and local settings
.claude/orchestration/
.claude/settings.local.json
scratchpad/
# testthat failure artifacts
tests/testthat/_problems/
tests/testthat/testthat-problems.rds

# Stray build/debug logs (untracked via git rm --cached)
/debug.log
/test_batch1.log
/test_solver.log

# Untracked root-level artefacts (codex workspace, reference PDFs, cookies)
.codex/
references/
cookies.txt
AGENTS.md
briefs/

# Dynare-generated output dirs inside model trees (Output/, graphs/, model/bytecode/)
inst/extdata/models/*/Output/
inst/extdata/models/*/graphs/
inst/extdata/models/*/model/bytecode/

*.tar.gz
check_*.out
