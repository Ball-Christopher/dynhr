mu <- c(0.5, -0.3)
sigma <- c(1.2, 0.8)
X <- cbind(rnorm(S, mu[1], sigma[1]),
           rnorm(S, mu[2], sigma[2]))
y_obs <- c(0.6, -0.5)
score_forecast(X, y_obs)

## Calibration diagnostics and the exact Gaussian predictive
